# .env.example — copie para .env e preencha os valores
PORT=3000
NODE_ENV=development
SESSION_SECRET=seuSegredoAqui
MONGO_URI=mongodb://localhost:27017/fatecweek
ADMIN_BOOTSTRAP_KEY=defina-uma-chave-secreta
ADMIN_AUTO_ADMINS=seu-admin@dominio.com
ADMIN_AUTO_DOMAIN=

# Email provider: 'smtp' (default) ou 'sendgrid'
EMAIL_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=SG_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=eventos@seudominio.com
SENDGRID_TEST_TO=seu.email@dominio.com

# SMTP fallback (se usar SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASS=senha
EMAIL_FROM=eventos@seudominio.com

# Certificado
CERT_THRESHOLD_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
